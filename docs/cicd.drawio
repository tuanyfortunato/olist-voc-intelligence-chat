<mxfile host="app.diagrams.net"><diagram name="CI/CD" id="cicd"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Voz do Cliente (Olist) – CI/CD" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="gh1" value="GitHub · a cada push e pull request" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#24292f;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1420" height="280" as="geometry"/></mxCell><mxCell id="feat" value="Branch feature/*&lt;br&gt;&lt;small&gt;push&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="180" height="64" as="geometry"/></mxCell><mxCell id="prdev" value="Pull request&lt;br&gt;&lt;small&gt;feature/* → develop&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="180" height="64" as="geometry"/></mxCell><mxCell id="prmain" value="Pull request&lt;br&gt;&lt;small&gt;develop → main&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="180" height="64" as="geometry"/></mxCell><mxCell id="merge" value="Merge na main" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="180" height="64" as="geometry"/></mxCell><mxCell id="checks" value="&lt;b&gt;CI&lt;/b&gt;: Ruff, pytest, build da imagem e testes da página, sem innerHTML&lt;br&gt;&lt;small&gt;&lt;b&gt;Terraform plan&lt;/b&gt; nos PRs que mudam infra/ · nenhum acesso à AWS no CI&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="700" height="70" as="geometry"/></mxCell><mxCell id="apply" value="Terraform apply&lt;br&gt;&lt;small&gt;toda a infra/&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="840" y="230" width="180" height="64" as="geometry"/></mxCell><mxCell id="deploy" value="Deploy&lt;br&gt;&lt;small&gt;imagem, ECS, página, cache&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1110" y="230" width="180" height="64" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="feat" target="prdev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prdev" target="prmain"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prmain" target="merge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.21428571428571427;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="feat" target="checks"><mxGeometry 