s3;verticalLabelPosition=top;verticalAlign=bottom;align=center;" vertex="1" parent="1"><mxGeometry x="122" y="640" width="56" height="56" as="geometry"/></mxCell><mxCell id="a1" value="plano aplicado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="apply" target="tfs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="360"/></Array></mxGeometry></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="deploy" target="pub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t1" value="grava e lê" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="task" target="rds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="task" target="bed"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="657"/></Array></mxGeometry></mxCell><mxCell id="t3" value="lê o índice · grava resultados" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="task" target="idx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gh2" value="GitHub · workflows manuais (workflow_dispatch)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#24292f;dashed=1;verticalAlign=bottom;spacingBottom=6;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1420" height="200" as="geometry"/></mxCell><mxCell id="build" value="Build index&lt;br&gt;&lt;small&gt;Kaggle → embeddings no Bedrock → Parquet no S3&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="180" height="84" as="geometry"/></mxCell><mxCell id="load" value="Load vectors&lt;br&gt;&lt;small&gt;carrega os vetores no RDS&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="260" y="860" width="180" height="84" as="geometry"/></mxCell><mxCell id="classify" value="Classify themes&lt;br&gt;&lt;small&gt;temas do painel · abre PR com o dashboard.json&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="460" y="860" width="180" height="84" as="geometry"/></mxCell><mxCell id="eval" value="Evaluate&lt;br&gt;&lt;small&gt;20 perguntas + RAGAS (juiz Nova Pro)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="660" y="860" width="180" height="84" as="geometry"/></mxCell><mxCell id="calib" value="Calibrate&lt;br&gt;&lt;small&gt;score mínimo da busca&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="860" y="860" width="180" height="84" as="geometry"/></mxCell><mxCell id="start" value="Start API&lt;br&gt;&lt;small&gt;liga API e banco fora do horário&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1060" y="860" width="180" height="84" as="geometry"/></mxCell><mxCell id="pubf" value="Publish frontend&lt;br&gt;&lt;small&gt;só a página&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1260" y="860" width="180" height="84" as="geometry"/></mxCell><mxCell id="m1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="build" target="idx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="load" target="task"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="780"/><mxPoint x="530" y="780"/></Array></mxGeometry></mxCell><mxCell id="m3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="classify" target="task"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="eval" target="task"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="780"/><mxPoint x="570" y="780"/></Array></mxGeometry></mxCell><mxCell id="m5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="calib" target="task"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="685"/></Array></mxGeometry></mxCell><mxCell id="m6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.6136363636363636;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pubf" target="pub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="630"/><mxPoint x="1250" y="630"/></Array></mxGeometry></mxCell><mxCell id="m7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.38636363636363635;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="pub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Fluxo do código:&lt;/b&gt; o trabalho é feito em branches feature/*, entra na develop por pull request e chega à main por outro pull request. O CI roda a cada push e PR e não usa credenciais da AWS. Cada merge na main aplica o Terraform, e quando ele termina o Deploy constrói a imagem, publica no ECR, atualiza o serviço no ECS, copia a página para o S3 e invalida o cache do CloudFront.&lt;br&gt;&lt;b&gt;Workflows manuais:&lt;/b&gt; o banco fica numa rede privada que o GitHub não alcança, então carga, classificação, avaliação e calibração rodam numa tarefa avulsa do ECS, com a imagem da branch escolhida." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1420" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>