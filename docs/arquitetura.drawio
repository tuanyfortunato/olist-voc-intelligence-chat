t="aws" source="cf" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_cf_alb" value="/api/* · HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="aws" source="cf" target="alb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_alb_ecs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="aws" source="alb" target="ecs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_ecs_ssm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="aws" source="ecs" target="ssm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="216"/></Array></mxGeometry></mxCell><mxCell id="e_ecs_cw" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="aws" source="ecs" target="cw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="228"/></Array></mxGeometry></mxCell><mxCell id="e_ecs_bed" value="embeddings · resposta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="aws" source="ecs" target="bedrock"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="246"/></Array></mxGeometry></mxCell><mxCell id="e_ecs_rds" value="busca vetorial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="aws" source="ecs" target="rds"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="261"/></Array></mxGeometry></mxCell><mxCell id="e_sched_ecs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;dashed=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="aws" source="sched" target="ecs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="392"/></Array></mxGeometry></mxCell><mxCell id="e_sched_rds" value="liga e desliga" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="aws" source="sched" target="rds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_ecr_ecs" value="imagem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="aws" source="ecr" target="ecs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="335"/><mxPoint x="415" y="335"/></Array></mxGeometry></mxCell><mxCell id="e_idx_rds" value="carga · tarefa ECS avulsa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="aws" source="s3idx" target="rds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_gha_ecr" value="publica" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.1;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="gha" target="ecr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="464" y="820"/><mxPoint x="230" y="820"/></Array></mxGeometry></mxCell><mxCell id="e_gha_idx" value="embeddings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="gha" target="s3idx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="656" y="820"/><mxPoint x="730" y="820"/></Array></mxGeometry></mxCell><mxCell id="e_kag_gha" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kaggle" target="gha"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Pergunta:&lt;/b&gt; a página chama &lt;i&gt;/api/ask&lt;/i&gt; pelo CloudFront. A tarefa no Fargate analisa a pergunta com o Nova Micro, gera o embedding com o Cohere, busca os 40 comentários mais próximos no pgvector, descarta os com score abaixo de 0,58, escolhe 15 por MMR e escreve a resposta com o Claude Haiku 4.5, citando os &lt;i&gt;review_id&lt;/i&gt;.&lt;br&gt;&lt;b&gt;Indexação:&lt;/b&gt; o GitHub Actions baixa a base do Kaggle, gera os 40.521 embeddings no Bedrock e grava o Parquet no S3. Uma tarefa avulsa no ECS carrega os vetores no RDS, e outra classifica as avaliações em temas para o dashboard.json do painel.&lt;br&gt;&lt;b&gt;Custo:&lt;/b&gt; API e banco ligados só no horário da demonstração, limite de 100 perguntas por hora por IP e 1.000 por dia e nenhuma chave guardada no repositório." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1080" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>