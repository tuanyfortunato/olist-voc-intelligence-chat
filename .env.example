# Modelo do arquivo de configuração.
# Copie este arquivo para .env e ajuste os valores. O .env não vai para o repositório.

# Região da AWS onde os modelos do Bedrock serão chamados
AWS_REGION=us-east-1

# Modelo de embeddings usado na indexação e na busca
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Modelo que verifica o escopo e gera as respostas
LLM_MODEL_ID=amazon.nova-micro-v1:0
