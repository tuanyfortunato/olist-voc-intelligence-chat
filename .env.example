# Modelo do arquivo de configuração.
# Copie este arquivo para .env e ajuste os valores. O .env não vai para o repositório.
# Todos os valores abaixo já são o padrão em src/config.py; só é preciso
# preencher o que for diferente.

# Região da AWS e modelos do Bedrock
AWS_REGION=us-east-1
EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3
EMBEDDING_DIMENSIONS=1024
LLM_MODEL_ID=amazon.nova-micro-v1:0

# Índice do Chroma e indexação (textos por chamada e chamadas ao mesmo tempo)
INDEX_DIR=data/index
COLLECTION_NAME=olist_reviews
EMBEDDING_BATCH_SIZE=96
INDEX_WORKERS=2

# Recuperação: candidatos buscados, comentários usados, score mínimo,
# peso da diversidade no MMR e tamanho mínimo do comentário
CANDIDATES_K=40
TOP_K=15
MIN_SIMILARITY=0.0
MMR_LAMBDA=0.5
MIN_COMMENT_CHARS=0

# Limite de tokens das respostas do Nova Micro
ANALYSIS_MAX_TOKENS=300
ANSWER_MAX_TOKENS=800

# Limites da API
MAX_QUESTION_CHARS=500
HISTORY_TURNS=3
HISTORY_ANSWER_CHARS=1500
DAILY_QUESTION_LIMIT=300

# Chave de acesso da página. Na AWS vem do Parameter Store.
ACCESS_KEY=

# INFO na AWS; DEBUG mostra os prompts e as respostas completas
LOG_LEVEL=INFO
